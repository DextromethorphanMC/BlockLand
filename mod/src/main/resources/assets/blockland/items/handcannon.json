{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "black",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_black"
              }
            },
            {
              "when": "gold",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_gold"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_magma"
              }
            },
            {
              "when": "gold_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_gold_beads"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/handcannon"
          }
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "black",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_black"
              }
            },
            {
              "when": "gold",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_gold"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_magma"
              }
            },
            {
              "when": "gold_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_gold_beads"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/handcannon_held_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/handcannon_held"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "blockland:item/handcannon_held",
      "model": {
        "type": "blockland:weapon",
        "fit": "blockland:item/handcannon_held"
      }
    }
  }
}
