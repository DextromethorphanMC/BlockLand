{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "black",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_black"
              }
            },
            {
              "when": "desert",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_desert"
              }
            },
            {
              "when": "thunder",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_thunder"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_magma"
              }
            },
            {
              "when": "gold_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_gold_beads"
              }
            },
            {
              "when": "silver_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_silver_beads"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/awp"
          }
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "black",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_black"
              }
            },
            {
              "when": "desert",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_desert"
              }
            },
            {
              "when": "thunder",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_thunder"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_magma"
              }
            },
            {
              "when": "gold_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_gold_beads"
              }
            },
            {
              "when": "silver_beads",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_silver_beads"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/awp_held_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/awp_held"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "blockland:item/awp_held",
      "model": {
        "type": "blockland:weapon",
        "fit": "blockland:item/awp_held"
      }
    }
  }
}
