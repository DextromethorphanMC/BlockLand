{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "desert",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/p9_desert"
              }
            },
            {
              "when": "gold",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/p9_gold"
              }
            },
            {
              "when": "camo",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/p9_camo"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/p9_arctic"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "cases": [
        {
          "when": "desert",
          "model": {
            "type": "minecraft:model",
            "model": "blockland:item/p9_held_desert"
          }
        },
        {
          "when": "gold",
          "model": {
            "type": "minecraft:model",
            "model": "blockland:item/p9_held_gold"
          }
        },
        {
          "when": "camo",
          "model": {
            "type": "minecraft:model",
            "model": "blockland:item/p9_held_camo"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "blockland:item/p9_held_arctic"
      }
    }
  }
}