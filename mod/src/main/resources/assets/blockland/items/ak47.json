          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "black",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/ak47_black"
              }
            },
            {
              "when": "desert",
              "model": {
