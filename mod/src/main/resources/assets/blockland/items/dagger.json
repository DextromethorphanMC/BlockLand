{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "blockland:item/dagger"
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "blockland:item/dagger_held"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "blockland:item/dagger_held",
      "model": {
        "type": "blockland:weapon",
        "fit": "blockland:item/dagger_held"
      }
    }
  }
}
