{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "two_tone",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_two_tone"
              }
            },
            {
              "when": "cerberus",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_cerberus"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_magma"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/usp_dual"
          }
        }
      },
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:custom_model_data",
          "index": 0,
          "cases": [
            {
              "when": "two_tone",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_held_two_tone"
              }
            },
            {
              "when": "cerberus",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_held_cerberus"
              }
            },
            {
              "when": "aurora",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_held_aurora"
              }
            },
            {
              "when": "magma",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_held_magma"
              }
            },
            {
              "when": "neon",
              "model": {
                "type": "minecraft:model",
                "model": "blockland:item/usp_dual_held_neon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blockland:item/usp_dual_held"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "blockland:item/usp_dual_held",
      "model": {
        "type": "blockland:weapon",
        "fit": "blockland:item/usp_dual_held"
      }
    }
  }
}
